# Agora Console credentials
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AREA=US

# Murf Dashboard API key (Agora will use Murf Falcon as the agent TTS provider)
MURF_API_KEY=
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US
MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input

# The LLM model can use Agora-managed mode when no vendor API key is supplied.
AGORA_LLM_MODEL=gpt-4o-mini
AGORA_STT_MODEL=nova-3

# Required for Agora custom tools: use an HTTPS URL reachable by Agora.
# For local development, expose port 8000 with a secure tunnel and paste its HTTPS URL here.
PUBLIC_BASE_URL=
TOOL_API_KEY=replace-with-a-long-random-secret

DATABASE_PATH=./data/nammaresolve.db
